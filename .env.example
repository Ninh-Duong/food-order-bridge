PORT=3000
NODE_ENV=production
SHOP_NAME=Food Order Shop
ORDER_TIMEZONE=Asia/Bangkok

# Cloud Database Connection String (Optional for local dev, required for Render production persistence)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/food-order-bridge?retryWrites=true&w=majority

# Telegram Bot Integration Settings
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890
