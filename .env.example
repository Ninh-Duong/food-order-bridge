PORT=3000
NODE_ENV=production
SHOP_NAME=Food Order Shop
ORDER_TIMEZONE=Asia/Bangkok

# Cloud Database Connection String (Optional for local dev, required for Render production persistence)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/food-order-bridge?retryWrites=true&w=majority

# Telegram Bot Integration Settings
# Tạm tắt thông báo đơn hàng outbound. Khi là false (mặc định), đơn hàng mới sẽ không gửi tới Telegram.
# Không ảnh hưởng Telegram webhook dùng để xem báo cáo.
TELEGRAM_ORDER_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_ADMIN_USER_IDS=123456789,987654321
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret-token
PUBLIC_BASE_URL=https://food-order-bridge.onrender.com
LOW_STOCK_THRESHOLD=5

# Payment: bật mock ở local/staging để test nút hoàn thành thanh toán.
# Không bật trong production khi đã dùng webhook thật.
PAYMENT_MOCK_ENABLED=true

# Payment capacity: mặc định toàn hệ thống tối đa 3 đơn chưa thanh toán,
# tự hủy sau 5 phút và giải phóng slot/tồn kho.
PAYMENT_PENDING_ORDER_LIMIT=3
PAYMENT_PENDING_TIMEOUT_MINUTES=5
PAYMENT_PENDING_SCOPE=ALL
PAYMENT_CAPACITY_ALERT_COOLDOWN_MINUTES=5

# Báo cáo Telegram định kỳ. Tắt mặc định để tránh gửi ngoài ý muốn.
REPORT_SCHEDULE_ENABLED=false
REPORT_DAILY_TIME=23:59
REPORT_WEEKLY_TIME=00:05
REPORT_MONTHLY_TIME=00:10

# Biểu đồ giờ cao điểm gửi kèm báo cáo Telegram
REPORT_CHART_ENABLED=true
REPORT_CHART_BASE_URL=https://quickchart.io/chart
REPORT_CHART_WIDTH=900
REPORT_CHART_HEIGHT=450

# Bank/VietQR. Để trống thì hệ thống hiển thị QR mock.
BANK_QR_BANK_CODE=VCB
BANK_QR_ACCOUNT_NUMBER=
BANK_QR_ACCOUNT_NAME=

# MoMo Merchant. Để trống thì hệ thống fallback sang QR mock.
MOMO_API_BASE_URL=https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_IPN_URL=https://your-domain.com/api/payments/momo/ipn
MOMO_REDIRECT_URL=https://your-domain.com/payment-result

# Admin authentication (AUTH_SECRET should be a long random value, at least 32 characters)
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

