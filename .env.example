PORT=3000
NODE_ENV=production
SHOP_NAME=Food Order Shop
ORDER_TIMEZONE=Asia/Bangkok

# Cloud Database Connection String (Optional for local dev, required for Render production persistence)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/food-order-bridge?retryWrites=true&w=majority

# Telegram Bot Integration Settings
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_ADMIN_USER_IDS=123456789,987654321
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret-token
PUBLIC_BASE_URL=https://food-order-bridge.onrender.com
LOW_STOCK_THRESHOLD=5

# Admin authentication (AUTH_SECRET should be a long random value, at least 32 characters)
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

